{
  "name": "progressive-ant-supercolony",
  "version": "0.6.0",
  "description": "Decentralized ant-colony Screeps AI",
  "author": "Fendy Jong",
  "license": "MIT",
  "scripts": {
    "build": "tsc -p .",
    "lint": "tslint \"src/**/*.ts\"",
    "clean": "rm -rf tsc-out && rm -rf dist",
    "compile": "rollup -c",
    "push-main": "rollup -c --environment DEST:main",
    "push-seasonal": "rollup -c --environment DEST:seasonal",
    "push-pserver": "rollup -c --environment DEST:pserver",
    "push-screepsplus": "rollup -c --environment DEST:screepsplus",
    "deploy": "npm run compile && cp dist/main.js screeps.com/default/main.js && cp dist/main.js screeps.com/seasonal/main.js && cp dist/main.js 127_0_0_1___21025/pserver/main.js",
    "deploy:pserver": "npm run compile && cp dist/main.js 127_0_0_1___21025/pserver/main.js"
  },
  "engines": {
    "node": "^20.11"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^11.0.2",
    "@rollup/plugin-node-resolve": "^7.1.1",
    "@types/lodash": "3.10.2",
    "@types/node": "^20.11.16",
    "@types/screeps": "^3.3.7",
    "rollup": "^2.6.0",
    "rollup-plugin-progress": "^1.1.1",
    "rollup-plugin-screeps": "^1.0.0",
    "rollup-plugin-typescript2": "^0.27.0",
    "semgrep": "^0.0.1",
    "tslint": "^5.20.0",
    "typedoc": "^0.14.2",
    "typescript": "5.3.3"
  }
}
